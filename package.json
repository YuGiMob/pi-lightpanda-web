{
  "name": "pi-lightpanda-web",
  "version": "0.1.2",
  "type": "module",
  "description": "Pi Lightpanda Web: web_search and web_fetch powered entirely by the local Lightpanda browser",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-lightpanda-web.git"
  },
  "author": "YuGiMob",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "web-search",
    "web-fetch",
    "lightpanda",
    "headless-browser"
  ],
  "license": "AGPL-3.0-only",
  "files": [
    "index.ts",
    "web-search.ts",
    "web-fetch.ts",
    "lightpanda.ts",
    "local-file.ts",
    "pdf-fetch.ts",
    "page-text.ts",
    "proxy.ts",
    "web-access.ts",
    "html-to-md.ts",
    "engines.ts",
    "entities.ts",
    "pdf.ts",
    "cache.ts",
    "settings.ts",
    "agent-dir.ts",
    "search-config.ts",
    "README.md",
    "LICENSE",
    "scripts/install-lightpanda.sh"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check:attw": "attw --pack",
    "check:package": "node -e \"const fs=require('fs');const pkg=require('./package.json');const listed=new Set(pkg.files);const bad=[];for(const f of pkg.files){if(!fs.existsSync(f))bad.push('missing file: '+f)}for(const f of fs.readdirSync('.').filter(f=>f.endsWith('.ts'))){if(!listed.has(f))bad.push('unlisted source: '+f)}if(bad.length){console.error(bad.join('\\n'));process.exit(1)}\"",
    "check:publint": "publint",
    "engine:eval": "node scripts/engine-eval.ts",
    "lint": "oxlint .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test:unit && npm run check:package && npm run check:publint",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts",
    "test:unit": "vitest run --exclude **/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@types/node": "^24.0.0",
    "typebox": "^1.3.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "@arethetypeswrong/cli": "^0.18.5",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24"
  },
  "optionalDependencies": {
    "mupdf": "^1.28.0"
  }
}
